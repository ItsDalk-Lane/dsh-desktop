{
  "name": "@deepseek-ai/dsh-desktop",
  "description": "DSH Desktop — DeepSeek Harness 引擎桌面发行版(插件中心/插件发现/视觉增强)",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "lib/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tests/tsconfig.json",
    "dev": "node --import tsx scripts/dev-desktop.ts",
    "dev:rebuild": "node --import tsx scripts/dev-desktop.ts --rebuild",
    "package": "pnpm --workspace-root run build && node --import tsx scripts/stage-runtime.ts && electron-builder --dir",
    "dist": "pnpm --workspace-root run build && node --import tsx scripts/stage-runtime.ts && electron-builder --publish never",
    "dist:win": "pnpm --workspace-root run build && DSH_DESKTOP_TARGET_PLATFORM=win32 DSH_DESKTOP_TARGET_ARCH=x64 node --import tsx scripts/stage-runtime.ts && node --import tsx scripts/release-win.ts",
    "publish:update": "node --import tsx scripts/publish-update.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/cordis-plugin-group": "workspace:^",
    "@deepseek-ai/cordis-plugin-include": "workspace:^",
    "@deepseek-ai/cordis-plugin-loader": "workspace:^",
    "@deepseek-ai/dsh-atomic-write": "workspace:^",
    "@deepseek-ai/dsh-app-boot": "workspace:^",
    "@deepseek-ai/dsh-home-paths": "workspace:^",
    "@deepseek-ai/dsh-launch-environment": "workspace:^",
    "@deepseek-ai/dsh-plugin-center-contracts": "workspace:^",
    "electron-updater": "6.8.9",
    "fflate": "^0.8.2",
    "js-yaml": "^4.2.0",
    "semver": "7.8.5",
    "tar": "7.5.22",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/ali-oss": "6.23.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.0",
    "ali-oss": "6.23.0",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "build": {
    "appId": "com.dshdesktop.app",
    "productName": "DSH Desktop",
    "afterPack": "./scripts/verify-packaged-runtime.ts",
    "asar": true,
    "files": [
      "lib/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "desktop-resources"
      },
      {
        "from": "runtime-host/package.json",
        "to": "host/package.json"
      },
      {
        "from": "runtime-host/node_modules",
        "to": "host/node_modules"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "ItsDalk-Lane",
        "repo": "dsh-desktop"
      }
    ],
    "toolsets": {
      "nsis": "1.2.1"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": false,
      "icon": "build/icon.icns",
      "notarize": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": "-",
      "artifactName": "DSH-Desktop-${version}-${arch}.${ext}"
    },
    "win": {
      "icon": "build/icon.ico",
      "artifactName": "DSH-Desktop-Windows-x64-${version}-Setup.${ext}",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "DSH Desktop"
    },
    "linux": {
      "category": "Development",
      "target": [
        "dir"
      ]
    },
    "directories": {
      "output": "dist-exe"
    }
  }
}